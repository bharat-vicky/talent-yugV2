# Coolify Docker Compose environment. Replace example.com with your actual domain.
NEXT_PUBLIC_APP_URL=https://example.com/pahchaan
NEXTAUTH_URL=https://example.com/pahchaan/api/auth
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/pahchaan?retryWrites=true&w=majority
AUTH_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JOB_WORKER_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JOB_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
# Required for email verification, password reset, invitations and email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional Google sign-in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional SMS delivery.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
