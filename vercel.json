{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "marketing": {
      "root": ".",
      "framework": "nextjs",
      "installCommand": "npm ci",
      "buildCommand": "npm run build"
    },
    "pahchaan": {
      "root": "Pahchaan",
      "framework": "nextjs",
      "installCommand": "npm ci",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    { "source": "/pahchaan", "destination": { "service": "pahchaan" } },
    { "source": "/pahchaan/(.*)", "destination": { "service": "pahchaan" } },
    { "source": "/(.*)", "destination": { "service": "marketing" } }
  ]
}
