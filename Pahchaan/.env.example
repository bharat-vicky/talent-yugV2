# Node.js 24 recommended. MongoDB must be a replica set or Atlas cluster.
MONGODB_URI=mongodb://127.0.0.1:27017/identity?replicaSet=rs0
NEXTAUTH_URL=http://localhost:3000/pahchaan/api/auth
NEXT_PUBLIC_APP_URL=http://localhost:3000/pahchaan
# Generate independent random secrets; do not use these placeholders in production.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
JOB_WORKER_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
# Set to an independent base64 encoded 32-byte key before enqueuing production jobs.
# Keep this key stable across authentication secret rotation.
JOB_ENCRYPTION_KEY=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Enable only behind a proxy that overwrites inbound forwarding headers.
TRUST_PROXY=false
